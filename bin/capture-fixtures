CGN_URL = "https://ftp.maps.canada.ca/pub/nrcan_rncan/vector/geobase_cgn_toponyme/prov_csv_eng/cgn_canada_csv_eng.zip"
# Real rows only: the header plus every row whose name is one of these, so tests cover ranking and ambiguity.
CGN_NAMES = ["Squamish", "Whistler", "Lake Louise", "Banff", "Canmore", "Revelstoke", "Edmonton", "Tofino",
             "Mount Robson", "Bow River", "Rivière-du-Loup", "Trois-Rivières", "Garibaldi", "Kelowna", "Jasper", "Québec", "Montréal",
             "Alberta", "Ottawa", "Ottawa River", "Rivière des Outaouais"].freeze

def fetch(url)
  uri = URI(url)
  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 15, read_timeout: 120) do |http|
    response = http.request(Net::HTTP::Get.new(uri, "user-agent" => USER_AGENT))
    response = fetch(URI.join(url, response["location"]).to_s) if response.is_a?(Net::HTTPRedirection)
    raise "#{url}: HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)

    response.body
  end
end

# Field reports without who submitted them.
def without_personal_fields(data)
  data.merge("items" => data.fetch("items").map { |item| item.except(*PERSONAL_FIELDS) })
end

def write(path, body)
  file = File.join(ROOT, path)
  FileUtils.mkdir_p(File.dirname(file))
  if path.end_with?(".json")
    data = JSON.parse(body)
    data = without_personal_fields(data) if path.start_with?("avalanche/min-")
    body = "#{JSON.pretty_generate(data)}\n"
  end
  File.write(file, body)
  puts "wrote #{path} (#{body.bytesize} bytes)"
end

def capture_cgn
  Dir.mktmpdir do |dir|
    archive = File.join(dir, "cgn.zip")
    File.binwrite(archive, fetch(CGN_URL))
    system("unzip", "-q", archive, "-d", dir, exception: true)
    csv = Dir[File.join(dir, "*.csv")].first
    lines = File.readlines(csv, encoding: "bom|utf-8")
    keep = lines.drop(1).select { |line| CGN_NAMES.include?(line.split(",", 3)[1]) }
    write("cgn/cgn_sample.csv", [lines.first, *keep].join)
  end
end

filter = ARGV.first.to_s
FIXTURES.each do |path, url|
  next unless path.start_with?(filter)

  # A lambda gives the frame time for the name, known only once the latest frame is captured (radar_map).
  if url.respond_to?(:call)
    time, url = url.call
    path = path.sub(/_[^_]+(\.\w+)\z/, "_#{time}\\1")
  end
  write(path, fetch(url))
  sleep 1
end
capture_cgn if "cgn/".start_with?(filter) || filter.start_with?("cgn/")
