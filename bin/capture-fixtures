#!/usr/bin/env ruby
# frozen_string_literal: true

# Captures real ECCC and NRCan responses into test/fixtures/. Run it by hand when a source's shape changes,
# then review the diff: tests depend on these files, and fixtures are never hand-written.
#
#   bin/capture-fixtures            # everything
#   bin/capture-fixtures api/       # only fixtures whose path starts with api/
#   bin/capture-fixtures avalanche  # only the Avalanche Canada fixtures
#
# Standard library only, so it runs before `bundle install`. One request at a time, a second apart. The one change
# made to upstream data: field reports lose the submitter's username and user id (PERSONAL_FIELDS) before they are
# written. Read the field reports' text before committing them, and pick another area if it holds contact details.

require "date"
require "fileutils"
require "json"
require "tmpdir"
require "net/http"
require "time"
require "uri"

ROOT = File.expand_path("../test/fixtures", __dir__)
USER_AGENT = "weather-canada-mcp-fixture-capture (+https://github.com/cloetzi/weather-canada-mcp)"
API = "https://api.weather.gc.ca"
GEOMET = "https://geo.weather.gc.ca/geomet"
AVALANCHE = "https://avcan-services-api.prod.avalanche.ca"
AVALANCHE_WEATHER = "https://weather.prod.avalanche.ca"
PERSONAL_FIELDS = %w[userID username].freeze

# A point query against a WMS layer: a 3x3 pixel map 0.02 degrees wide, centred on the point (as Sources::Wms asks).
def feature_info(layer, lat, lon, time = nil)
  d = 0.01
  params = {
    SERVICE: "WMS", VERSION: "1.3.0", REQUEST: "GetFeatureInfo", LAYERS: layer, QUERY_LAYERS: layer,
    CRS: "EPSG:4326", BBOX: [lat - d, lon - d, lat + d, lon + d].map { |v| v.round(4) }.join(","),
    WIDTH: 3, HEIGHT: 3, I: 1, J: 1, INFO_FORMAT: "application/json"
  }
  params[:TIME] = time.strftime("%Y-%m-%dT%H:%M:%SZ") if time
  "#{GEOMET}?#{URI.encode_www_form(params)}"
end

# What Tools::GetSnowOutlook asks for 24 hours ahead: four 6-hour steps from the 6-hour UTC boundary before now, with
# snow level, 6-hour snow and blowing snow at the end of each. The fake serves them as geomet/<place>/<layer>_<time>.json.
SNOW_START = Time.at(Time.now.to_i / 21_600 * 21_600).utc
SNOW_LAYERS = %w[HRDPS-WEonG_2.5km_SnowLevelHeight RDPS_10km_Snow-Accum6h HRDPS-WEonG_2.5km_BlowingSnow-Prob].freeze
def snow_outlook(place, lat, lon, layers = SNOW_LAYERS)
  ends = (1..4).map { |k| SNOW_START + (k * 21_600) }
  ends.product(layers).to_h do |t, layer|
    ["geomet/#{place}/#{layer}_#{t.strftime("%Y%m%dT%H%MZ")}.json", feature_info(layer, lat, lon, t)]
  end
end

def items(collection, **params) = "#{API}/collections/#{collection}/items?#{URI.encode_www_form({ f: "json" }.merge(params))}"

def bbox(lat, lon, half = 0.01) = [lon - half, lat - half, lon + half, lat + half].map { |v| v.round(4) }.join(",")

# The bbox the tools send: Geo.bbox(lat, lon, radius_km).
def bbox_km(lat, lon, radius_km)
  d_lat = radius_km / 111.32
  d_lon = radius_km / (111.32 * [Math.cos(lat * Math::PI / 180), 0.01].max)
  [lon - d_lon, lat - d_lat, lon + d_lon, lat + d_lat].map { |v| v.round(5) }.join(",")
end

# The bbox of the 0.5 degree grid cell holding the point, grown to still hold radius_km around it: Geo.snapped_bbox.
def snapped_bbox_km(lat, lon, radius_km)
  snap = ->(degrees) { ((degrees / 0.5).floor + 0.5) * 0.5 }
  bbox_km(snap.call(lat), snap.call(lon), radius_km + 35)
end

# As the M2 tools request them (keep in step with Tools::GetCurrentObservations::FIELDS).
SWOB_ELEMENTS = %w[air_temp dwpt_temp rel_hum avg_wnd_spd_10m_pst2mts avg_wnd_spd_10m_pst10mts avg_wnd_dir_10m_pst2mts
                   avg_wnd_dir_10m_pst10mts max_wnd_gst_spd_10m_pst10mts max_wnd_spd_10m_pst1hr mslp stn_pres vis
                   tot_cld_amt pcpn_amt_pst1hr pcpn_amt_pst6hrs pcpn_amt_pst24hrs snwfl_amt_pst1hr snw_dpth
                   avg_snw_dpth_pst5mts max_air_temp_pst24hrs min_air_temp_pst24hrs].freeze
SWOB_PROPERTIES = ["date_tm-value", *SWOB_ELEMENTS, *SWOB_ELEMENTS.map { |e| "#{e}-qa" }].join(",")
def swob(msc_id) = items("swob-realtime", "msc_id-value": msc_id, sortby: "-date_tm-value", limit: 6, properties: SWOB_PROPERTIES)

# What Sources::ECCC::Stations asks for.
HYDRO_STATION_PROPERTIES = "STATION_NAME,STATION_NUMBER,PROV_TERR_STATE_LOC,CONTRIBUTOR_EN,CONTRIBUTOR_FR,DRAINAGE_AREA_GROSS"

# The past 72 hours, from the start of the hour, as Tools::GetRiverConditions asks.
HYDRO_SINCE = Time.at((Time.now.to_i - (72 * 3600)) / 3600 * 3600).utc.strftime("%Y-%m-%dT%H:%M:%SZ")
def hydro_realtime(number)
  items("hydrometric-realtime", STATION_NUMBER: number, datetime: "#{HYDRO_SINCE}/..", sortby: "-DATETIME",
                                properties: "DATETIME,LEVEL,DISCHARGE", skipGeometry: true, limit: 3000)
end

def hydro_monthly(number)
  items("hydrometric-monthly-mean", STATION_NUMBER: number, properties: "DATE,MONTHLY_MEAN_DISCHARGE", skipGeometry: true, limit: 2000)
end

# A GetMap PNG of one layer over the area Tools::GetRadarMap asks for (Sources::Wms#get_map).
def get_map(layer, style, bbox, time)
  min_lon, min_lat, max_lon, max_lat = bbox.split(",")
  params = { SERVICE: "WMS", VERSION: "1.3.0", REQUEST: "GetMap", LAYERS: layer, STYLES: style, CRS: "EPSG:4326",
             BBOX: [min_lat, min_lon, max_lat, max_lon].join(","), WIDTH: 512, HEIGHT: 512, FORMAT: "image/png",
             TRANSPARENT: "TRUE", TIME: time.strftime("%Y-%m-%dT%H:%M:%SZ") }
  "#{GEOMET}?#{URI.encode_www_form(params)}"
end

def basemap(bbox)
  min_lon, min_lat, max_lon, max_lat = bbox.split(",")
  params = { SERVICE: "WMS", VERSION: "1.3.0", REQUEST: "GetMap", LAYERS: "CBMT", STYLES: "", CRS: "EPSG:4326",
             BBOX: [min_lat, min_lon, max_lat, max_lon].join(","), WIDTH: 512, HEIGHT: 512, FORMAT: "image/png" }
  "https://maps.geogratis.gc.ca/wms/CBMT?#{URI.encode_www_form(params)}"
end

# What Tools::GetRadarMap asks for at a place in snow mode, 100 km around: the latest snow rate first, then the rest
# for that frame (layer_frame.json is renamed layer_<time>.json once the frame is known).
def radar_map(place, lat, lon)
  latest = "geomet/#{place}/RADAR_1KM_RSNO_latest.json"
  bbox = bbox_km((lat / 0.05).round * 0.05, (lon / 0.05).round * 0.05, 100)
  {
    latest => feature_info("RADAR_1KM_RSNO", lat, lon),
    "geomet/#{place}/Radar_1km_SfcPrecipType_latest.json" => feature_info("Radar_1km_SfcPrecipType", lat, lon),
    "geomet/#{place}/RADAR_1KM_RRAI_frame.json" => at_frame(latest) { |time| feature_info("RADAR_1KM_RRAI", lat, lon, time) },
    "geomet/#{place}/RADAR_1KM_RSNO_30.json" => at_frame(latest, 30) { |time| feature_info("RADAR_1KM_RSNO", lat, lon, time) },
    "geomet/#{place}/RADAR_1KM_RSNO_60.json" => at_frame(latest, 60) { |time| feature_info("RADAR_1KM_RSNO", lat, lon, time) },
    "geomet/#{place}/RADAR_1KM_RSNO_map.png" => at_frame(latest) { |time| get_map("RADAR_1KM_RSNO", "Radar-Snow_14colors", bbox, time) },
    "geomet/#{place}/RADAR_COVERAGE_RRAI.INV_map.png" =>
      at_frame(latest) { |time| get_map("RADAR_COVERAGE_RRAI.INV", "Radar-Coverage_Inv-LightGray", bbox, time) },
    "nrcan/cbmt_#{place}.png" => basemap(bbox)
  }
end

# A lambda giving [time for the file name, URL] for the frame minutes before the one in the latest fixture.
def at_frame(latest, minutes_before = 0)
  lambda do
    frame = JSON.parse(File.read(File.join(ROOT, latest), encoding: Encoding::UTF_8)).dig("features", 0, "properties", "time")
    time = Time.iso8601(frame).utc - (minutes_before * 60)
    [time.strftime("%Y%m%dT%H%MZ"), yield(time)]
  end
end

# As Tools::Avalanche::GetForecast asks: the point rounded to 0.01 degrees.
def avalanche_point(lang, lat, lon)
  "#{AVALANCHE}/forecasts/#{lang}/products/point?#{URI.encode_www_form(lat: format("%.2f", lat), long: format("%.2f", lon))}"
end

# As Tools::Avalanche::GetMountainWeatherStations asks by default: the 24 hours up to the next full hour.
AVALANCHE_TO = Time.at((Time.now.to_i + 3599) / 3600 * 3600).utc
def measurements(station_id)
  query = URI.encode_www_form(fromDate: (AVALANCHE_TO - 86_400).iso8601, toDate: AVALANCHE_TO.iso8601)
  "#{AVALANCHE_WEATHER}/stations/#{station_id}/measurements?#{query}"
end

# As Tools::Avalanche::GetFieldReports asks: from days - 1 before today at UTC-8 to today's UTC date, at most 31 days, within radius_km.
def min_submissions(lat, lon, radius_km, days)
  today = Time.now.utc.to_date
  from = [(Time.now.utc - (8 * 3600)).to_date - (days - 1), today - 30].max
  query = URI.encode_www_form(fromdate: from.iso8601, todate: today.iso8601, bbox: bbox_km(lat, lon, radius_km))
  "#{AVALANCHE}/min/submissions?#{query}"
end

